{
  "name": "agentready",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drop-in script that makes small-business websites usable by AI agents via WebMCP.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env dev.mjs",
    "test": "AGENTREADY_MOCK=1 node --test",
    "agent": "node --env-file-if-exists=.env agent/run.mjs",
    "gauntlet": "node --env-file-if-exists=.env agent/gauntlet.mjs",
    "generate": "node --env-file-if-exists=.env agent/generate.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
